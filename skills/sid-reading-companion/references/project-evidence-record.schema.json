{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sid-reading-companion:project-evidence-audit:0.3.8",
  "title": "Project Evidence Audit Record 0.3.8",
  "description": "Additive audit record outside Reading Companion learner/session state.",
  "type": "object",
  "required": ["contract_version", "case_id", "artifact", "selection", "searched", "source_context", "handoff"],
  "properties": {
    "contract_version": {"const": "project-evidence-audit-0.3.8"},
    "case_id": {"type": "string", "minLength": 1},
    "artifact": {
      "type": "object", "required": ["path", "sha256"], "additionalProperties": false,
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "selection": {
      "type": "object",
      "required": ["selection_id", "purpose", "scope", "basis", "universe_ref", "criterion", "members", "exclusions_or_not_evaluated", "completeness", "count", "count_basis"],
      "additionalProperties": false,
      "properties": {
        "selection_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "basis": {"enum": ["author_explicit", "ai_selection", "user_selection", "mixed"]},
        "universe_ref": {"type": ["string", "null"]},
        "criterion": {"type": "string", "minLength": 1},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "exclusions_or_not_evaluated": {"type": "string", "minLength": 1},
        "completeness": {"enum": ["complete_in_verified_scope", "partial", "unknown"]},
        "count": {"type": "integer", "minimum": 0},
        "count_basis": {"enum": ["author_stated", "derived_after_selection", "user_limit", "unknown"]}
      },
      "allOf": [
        {"if": {"properties": {"completeness": {"const": "complete_in_verified_scope"}}},
         "then": {"properties": {"universe_ref": {"type": "string", "minLength": 1, "not": {"pattern": "^unknown$"}}}}}
      ]
    },
    "searched": {
      "type": "object", "required": ["boundary", "inspected", "not_examined", "stop_reason", "stop_basis"],
      "additionalProperties": false,
      "properties": {
        "boundary": {"type": "string", "minLength": 1},
        "inspected": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "not_examined": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "stop_reason": {"type": "string", "minLength": 1},
        "stop_basis": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}
      }
    },
    "source_context": {
      "type": "object", "required": ["source_snapshot", "implementation_revision", "current_runtime"],
      "additionalProperties": false,
      "properties": {
        "source_snapshot": {
          "type": "object", "required": ["source_id", "path", "sha256", "document_version", "document_date"],
          "additionalProperties": false,
          "properties": {
            "source_id": {"type": "string", "minLength": 1},
            "path": {"$ref": "#/$defs/relativePath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "document_version": {"type": ["string", "null"]},
            "document_date": {"type": ["string", "null"]}
          }
        },
        "implementation_revision": {"$ref": "#/$defs/versionFact"},
        "current_runtime": {"$ref": "#/$defs/versionFact"}
      }
    },
    "handoff": {
      "type": "object", "required": ["next_owner", "ack_status", "ack_evidence"], "additionalProperties": false,
      "properties": {
        "next_owner": {"type": "string", "minLength": 1},
        "ack_status": {"enum": ["confirmed", "unknown"]},
        "ack_evidence": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      },
      "allOf": [
        {"if": {"properties": {"ack_status": {"const": "confirmed"}}}, "then": {"properties": {"ack_evidence": {"minItems": 1}}}},
        {"if": {"properties": {"ack_status": {"const": "unknown"}}}, "then": {"properties": {"ack_evidence": {"maxItems": 0}}}}
      ]
    },
    "narrative": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:).*"},
    "span": {
      "type": "object", "required": ["path", "sha256", "line_start", "line_end", "excerpt"], "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "member": {
      "type": "object", "required": ["ref", "origin", "source_locators", "inclusion_reason"], "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "origin": {"enum": ["source", "ai_proposed", "user_provided"]},
        "source_locators": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "inclusion_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"origin": {"const": "source"}}},
         "then": {"properties": {"source_locators": {"minItems": 1}}}}
      ]
    },
    "versionFact": {
      "oneOf": [
        {
          "type": "object", "required": ["status", "value", "evidence"], "additionalProperties": false,
          "properties": {"status": {"const": "known"}, "value": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}}
        },
        {
          "type": "object", "required": ["status", "value", "evidence"], "additionalProperties": false,
          "properties": {"status": {"const": "unknown"}, "value": {"type": "null"}, "evidence": {"type": "array", "maxItems": 0}}
        }
      ]
    }
  }
}
